{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Braid",
  "version": "0.1.0-alpha.8",
  "identifier": "com.sbkbk.braid",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Braid",
        "maximized": true,
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Bilal Khalid",
    "copyright": "Copyright 2026 Bilal Khalid",
    "shortDescription": "A fast, keyboard-first Git client",
    "longDescription": "Braid is a Git client that keeps lazygit's keyboard model and adds a real interface: a lane graph for history, staging by hunk and line, blame, search, git flow, worktrees and submodules. Every action runs through your own git, so hooks, credential helpers and signing behave as they do in your terminal.",
    "homepage": "https://github.com/bilalkhalid1000/braid",
    "license": "MIT",
    "category": "DeveloperTool"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFQ0NERkE2M0Q5MUY3QgpSV1I3SDlsaitzM3NDdVorbTNWUVhYdEZZSGx1dzg4MzN2N1RkbzhaS0NGRGZmd3J1S3FVazVUNAo=",
      "endpoints": [
        "https://github.com/bilalkhalid1000/braid/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
